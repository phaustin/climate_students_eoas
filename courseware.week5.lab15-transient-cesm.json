de","children":[{"type":"code","lang":"python","executable":true,"value":"def global_mean(field, weight=gw):\n    '''Return the area-weighted global average of the input field'''\n    return (field*weight).mean(dim=('lat','lon'))/weight.mean(dim='lat')","key":"uBgwYvKmJi"},{"type":"outputs","id":"lHV-XZGqFxm9KrpKxSqep","children":[],"key":"fgAmPUMeQS"}],"key":"kPq0IW63l6"},{"type":"block","children":[],"key":"zuX5umVJ8P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#  Loop through the four simulations and produce the global mean timeseries\nTREFHT_global = {}\nfor name in casenames:\n    TREFHT_global[name] = global_mean(atm[name].TREFHT)","key":"ufAIv9zBlr"},{"type":"outputs","id":"-Ysby5lkPUlLe4YgKaUYa","children":[],"key":"WyoIlujEN8"}],"key":"dLgVv9Vg5o"},{"type":"block","children":[{"type":"heading","depth":4,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"Make some pretty timeseries plots, including an ","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"A3EvsqDNzi"},{"type":"strong","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"approximate","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"t04nDWYWj3"}],"key":"HAmWNhzNkP"},{"type":"text","value":" running annual average","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"Yec4Sr14Hm"}],"identifier":"make-some-pretty-timeseries-plots-including-an-approximate-running-annual-average","label":"Make some pretty timeseries plots, including an approximate running annual average","html_id":"make-some-pretty-timeseries-plots-including-an-approximate-running-annual-average","implicit":true,"key":"lzQYkhSfo9"}],"key":"gqDJEjfIQO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(2,1,figsize=(10,8))\nfor name in casenames:\n    if 'cpl' in name:\n        ax = axes[0]\n        ax.set_title('Fully coupled ocean')\n    else:\n        ax = axes[1]\n        ax.set_title('Slab ocean')\n    field = TREFHT_global[name]\n    field_running = field.rolling(time=12, center=True).mean()\n    line = ax.plot(field.time / days_per_year, \n                   field, \n                   label=name,\n                   linewidth=0.75,\n                   )\n    ax.plot(field_running.time / days_per_year, \n            field_running, \n            color=line[0].get_color(),\n            linewidth=2,\n           )\nfor ax in axes:\n    ax.legend();\n    ax.set_xlabel('Years')\n    ax.set_ylabel('Temperature (K)')\n    ax.grid();\n    ax.set_xlim(0,100)\nfig.suptitle('Global mean surface air temperature in CESM simulations', fontsize=16);","key":"MqcaWrWfs2"},{"type":"outputs","id":"jHlQweobZXVxPRYayXBN8","children":[],"key":"CWIguWrYlm"}],"key":"aHpEt7xAiV"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"Issues to think about here include:","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"PlVKVfupXb"}],"key":"pduwMjy23F"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":178,"column":1},"end":{"line":182,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Why is the annual average here only approximate? ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"t55M0syDa2"},{"type":"emphasis","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"(think about the calendar)","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}}