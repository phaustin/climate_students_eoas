,"column":1}},"children":[{"type":"text","value":"We can see that there are 40 different ensemble members (as we expect for CESM LENS1)","position":{"start":{"line":198,"column":1},"end":{"line":198,"column":1}},"key":"tMrwM5OkAC"}],"key":"rTkvSVglq3"},{"type":"paragraph","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"children":[{"type":"text","value":"Let’s create a quick plot for a slice of the data for a subset of the ensemble members","position":{"start":{"line":201,"column":1},"end":{"line":201,"column":1}},"key":"ImbJpPn497"}],"key":"jX1CerBbq5"},{"type":"code","lang":"python","value":"ds.PSL.isel(time=0, member_id=range(1, 40, 4)).plot(col=\"member_id\", col_wrap=3, robust=True)","position":{"start":{"line":203,"column":1},"end":{"line":205,"column":1}},"key":"olMk3yprjZ"},{"type":"code","lang":"python","value":"# Let's look at how sea level pressure has changed over time in different ensemble members, \n# for a grid box close to Vancouer \nfor iens in range(1,40,4): # only selecting every 4th ensemble member so the plot isn't too messy. \n    ds.PSL.sel(lat = 50, lon=237, method = 'nearest').isel(member_id=iens).plot()\n    \n# Plot the ensemble mean on top\nds.PSL.sel(lat = 50, lon=237, method = 'nearest').mean(dim='member_id').plot(color='k')","position":{"start":{"line":207,"column":1},"end":{"line":215,"column":1}},"key":"dS26hAT7S5"},{"type":"code","lang":"python","value":"# What if we look at the CTRL simulation instead?\nds_ctrl = dset_dict[\"atm.CTRL.monthly\"]\nds_ctrl","position":{"start":{"line":217,"column":1},"end":{"line":221,"column":1}},"key":"r24A2ZGQUD"},{"type":"paragraph","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"children":[{"type":"text","value":"There are now no separate ensemble members: this is just one long control simulation of 21612/12 = 1801 years! In this case, the forcing (approximating pre-industrial forcing) is constant over time, unlike in the 20th century simulations, where the forcing changes with time. Think about why this means that it’s reasonable to run a single 1801-year simulation for the control simulation, but necessary to have multiple ensemble members for the 20th century simulations.","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"EwBAvFMN2J"}],"key":"IxFpkNWtq7"},{"type":"heading","depth":3,"position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"children":[{"type":"text","value":"For CESM LENS2","position":{"start":{"line":226,"column":1},"end":{"line":226,"column":1}},"key":"ha2IWXhgO7"}],"identifier":"for-cesm-lens2","label":"For CESM LENS2","html_id":"for-cesm-lens2","implicit":true,"key":"r1raeLYAcL"},{"type":"code","lang":"python","value":"cat2.esmcat.aggregation_control","position":{"start":{"line":228,"column":1},"end":{"line":230,"column":1}},"key":"MGbM2ng4i1"},{"type":"code","lang":"python","value":"## For CESM LENS2:\ndset_dict2 = cat_subset2.to_dataset_dict(\n    xarray_open_kwargs={\"consolidated\": True, \"decode_times\": True}, storage_options={\"anon\": True}\n)","position":{"start":{"line":232,"column":1},"end":{"line":237,"column":1}},"key":"Fc24a6y0ND"},{"type":"code","lang":"python","value":"[key for key in dset_dict2.keys()][:10]","position":{"start":{"line":239,"column":1},"end":{"line":241,"column":1}},"key":"KREZean16u"},{"type":"code","lang":"python","value":"ds_cmip6 = dset_dict2[\"atm.ssp370.monthly.cmip6\"]\nds_cmip6","position":{"start":{"line":243,"column":1},"end":{"line":246,"column":1}},"key":"fYq5fnoKPC"},{"type":"code","lang":"python","value":"# Here we have 50 members. There are 50 other members under the 'smbb' \n# (see https://www.cesm.ucar.edu/community-projects/lens2 ) for more details on these differences, related\n# to biomass burning emissions\nds_smbb = dset_dict2[\"atm.ssp370.monthly.smbb\"]\nds_smbb","position":{"start":{"line":248,"column":1},"end":{"line":254,"column":1}},"key":"lAmLiDGRRP"},{"type":"code","lang":"python","value":"# Unless you think your results will be critically sensitive to the exact biomass burning specification, \n# you can combine these two sets of 50 members to create one 100 member ensemble.\nmerge_ds= xr.concat([ds_cmip6, ds_smbb], dim='member_id')\nmerge_ds","position":{"start":{"line":256,"column":1},"end":{"line":261,"column":1}},"key":"Lh6iXO26fT"},{"type":"code","lang":"python","value":"# information about the start year can be found in the member_id:\n# e.g. r10i1181p1f1 is initialized on year 1181\n# In the print-out below, you can see that some initialization dates have just one member, e.g. 1181: r10i1181p1f1, \n# whilst others have mutliple members, with micro-perturbations to the initial conditions, e.g. 1281: r1i1281p1f1,\n# r2i1281p1f1, r3i1281p1f1 etc...\nmerge_ds.member_id","position":{"start":{"line":263,"column":1},"end":{"line":270,"column":1}},"key":"q50vZ4rwIK"},{"type":"code","lang":"python","value":"","position":{"start":{"line":272,"column":1},"end":{"line":274,"column":1}},"key":"blegvQBBW7"}],"key":"oESHw3nACn"}],"key":"c7HWXn0bsc"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Accessing CMIP6 data with intake-esm","url":"/loading-cmip6-data","group":"Project requirements overview"},"next":{"title":"Worksheet: Comparing total cloud fraction in hot and cold models","url":"/hot-cold-models","group":"Project requirements overview"}}},"domain":"http://localhost:3004"}