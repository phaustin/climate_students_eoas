Book","key":"rFSiruvtP8"},{"type":"text","value":" by ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"UmY3qXS7Jr"},{"type":"link","url":"http://www.atmos.albany.edu/facstaff/brose/index.html","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Brian E. J. Rose","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"sil3bJWJCx"}],"urlSource":"http://www.atmos.albany.edu/facstaff/brose/index.html","key":"V7uutX7liD"},{"type":"text","value":", University at Albany.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"RKhaqefkay"}],"key":"KmcXaIgAlg"}],"key":"P2nq9psCsL"},{"type":"block","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Preface","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"VvCOfL7ZjJ"}],"identifier":"preface","label":"Preface","html_id":"preface","implicit":true,"key":"HLXV8ad9QI"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"In the homework assignment you are asked to compute various terms in the global-average energy budget from the CESM control simulation and compare them to the observations.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ZqdgXlz0Xr"}],"key":"a6OhKAO4h4"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"In the lecture notes, we walked through how to open the dataset and compute the time- and global averages.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"VebeC5JO10"}],"key":"cOm10DnZ96"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The main challenge here is just understanding how to relate the diagnostic fields in the CESM output dataset to the quantities you are asked to calculate. I give some additional guidance here.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"FsqqN3ZB3B"}],"key":"T7zk3Opr8v"}],"key":"iPiunaU1sm"},{"type":"block","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"What do we mean by “upwelling”, “downwelling”, “net”?","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"wS8K1UkNid"}],"identifier":"what-do-we-mean-by-upwelling-downwelling-net","label":"What do we mean by “upwelling”, “downwelling”, “net”?","html_id":"what-do-we-mean-by-upwelling-downwelling-net","implicit":true,"key":"gYur4TLQAw"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"To understand these terms, just picture the beam of radiation traveling between the surface of the Earth and the top of that atmosphere. “Downwelling” means traveling downward (i.e. toward the surface), and “upwelling” means traveling upward.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"EdlsonTs8G"}],"key":"YGjFP6swYG"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"The beam of shortwave (solar) radiation arrives from the sun at the top of the atmosphere and travels downward. Some of that beam is reflected back upward. So the quantity we have denoted as Q in our notes, the total sunlight incident upon the Earth, is the downwelling shorwave flux at the top of the atmosphere. The upwelling shortwave flux at the top of the atmosphere is a number that is smaller than Q and represents the reflection.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"jnajKNXKMu"}],"key":"cBIZGBzkRg"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"For the longwave beam, it’s the same idea — there is a beam moving upward, or “upwelling”, and a beam moving downward, or “downwelling”. The difference is that this beam is generated by the Earth and the atmosphere itself.\nThe upwelling flux at the surface is the surface emission. The downwelling flux at the surface is the radiation absorbed by the surface (originating somewhere in the atmosphere).","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"DpCA7PNOoy"}],"key":"xw233f7ylo"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The “net” flux is the difference between the upwelling and downwelling beams. We have to be careful about sign conventions! In the CESM data, “net” means net upward for longwave radiation, but net downward for shortwave radiation.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"jDUsvgdnUy"}],"key":"mIoAfcoA2T"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"The net longwave flux at the top of the atmosphere is what we have called the Outgoing Longwave Radiation.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"qp3WlWrN6E"}],"key":"sAKodon3FS"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The net shortwave flux at the top of the atmosphere is what we have called the Absorbed Shortwave Radiation.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"TjlGREvBo9"}],"key":"Nr5v7YU8Ye"}],"key":"MpnvNd73WK"},{"type":"block","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"From the lecture notes -- CESM naming conventions","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"j0rkC3eKmT"}],"identifier":"from-the-lecture-notes-cesm-naming-conventions","label":"From the lecture notes -- CESM naming conventions","html_id":"from-the-lecture-notes-cesm-naming-conventions","implicit":true,"key":"PTFuXC2h48"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Reproduced from the lecture notes:","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"RoSpg8NBa8"}],"key":"FhBi4Va7UM"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The model output contains lots of diagnostics about the radiative fluxes. Here are some CESM naming conventions to help you find the appropriate output fields:","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"DdAq4AXk0K"}],"key":"Hp3R3uwNPg"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":54,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"All variables whose names being with ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"XqjxrWp04i"},{"type":"inlineCode","value":"'F'","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"kiPmVw90QG"},{"type":"text","value":" are an ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"WEQfJcKxYn"},{"type":"strong","posi