e":108,"column":1}},"children":[{"type":"text","value":"In the case of our missing ","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"dCE5o8kheE"},{"type":"inlineCode","value":"FSUT","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"SBAYO00c4v"},{"type":"text","value":" field, the key point is that we do have the “Net” field ","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"RWqnRLavHV"},{"type":"inlineCode","value":"FSNT","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"Abd4kpwnmH"},{"type":"text","value":" and the downwelling field ","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"QBWIssDjMD"},{"type":"inlineCode","value":"SOLIN","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"VICdp1PQxs"},{"type":"text","value":".","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"XzdZlc6tkM"}],"key":"KANyZV41V3"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Since the Net Flux is the difference:","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"kFB6C4C1ep"}],"key":"w1cNH57sDr"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"inlineCode","value":"FSNT = SOLIN - FSUT","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"kVjRfrp7ms"}],"key":"Gtf15Mys9m"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"(i.e. the difference between what’s coming in and what’s going out!)","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"b33FgWDsxt"}],"key":"CPbR7XQbCB"},{"type":"paragraph","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"then we can rearrange this to solve for our unknown field:","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"HlkgRqOUU2"}],"key":"xvq8fCSS9r"},{"type":"paragraph","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"inlineCode","value":"FSUT = SOLIN - FSNT","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"QRW3IQXTUv"}],"key":"EQmS1qL3Gm"},{"type":"paragraph","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"We can do this kind of arithmetic with the xarray datasets:","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"moq9LSodTn"}],"key":"HfVz1LyS4j"}],"key":"vGHF1ldxnp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#  Take the difference between the downwelling shortwave flux at the net shortwave flux at the top of atmosphere\n#  The result is the upwelling flux, i.e. the reflected shortwave flux\n#   Store this difference in a new variable called FSUT\nFSUT = atm_control.SOLIN - atm_control.FSNT","key":"QGcUCmKECr"},{"type":"outputs","id":"S6WHm_l1AK4G_AS720g8N","children":[],"key":"PmUKVkKM5n"}],"key":"CnYNDaHblo"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"A few other derived field examples","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"g92si6NjG8"}],"identifier":"a-few-other-derived-field-examples","label":"A few other derived field examples","html_id":"a-few-other-derived-field-examples","implicit":true,"key":"VQHKqTE2BQ"},{"type":"paragraph","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"In the homework I ask you calculate the longwave “Upward emission from the surface”. That should be ","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"ksSTKuLRFD"},{"type":"inlineCode","value":"FLUS","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"Mrk0QoxfWv"}],"key":"UtaH7VCUNc"}],"key":"ULWIw3lwMs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"atm_control.FLUS","key":"ryYxSfAs9E"},{"type":"outputs","id":"_arejWWiPmnZY2DJ_wfRi","children":[],"key":"CPsshKjHKg"}],"key":"LNt9vx9ucO"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Same problem as above, and same solution.","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"xEhARYvChA"}],"key":"ZrNGUBaG3B"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"We have the downwelling flux ","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"GUcosym0Fl"},{"type":"inlineCode","value":"FLDS","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"qZ2sEUiamC"},{"type":"text","value":" (positive down), and the net flux ","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"kqOzzdIVPq"},{"type":"inlineCode","value":"FLNS","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"EBAs3ihnL4"},{"type":"text","value":" (positive up). The net flux is defined as","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"bpYbK2fxHj"}],"key":"DNl3wAHvq1"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"inlineCode","value":"FLNS = FLUS - FLDS","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"UoT7bPAhl3"}],"key":"Ax9kd6GwPe"},{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"We get the upward flux by rearranging:","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"EgHvWI4jnx"}],"key":"Rz8T84psGg"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"inlineCode","value":"FLUS = FLNS + FLDS","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"Tobs0CuE2L"}],"key":"UUmRJjSyXP"}],"key":"MJnQTlyR6y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"FLUS = atm_control.FLDS + atm_control.FLNS","key":"LYJWRz0VT6"},{"type":"outputs","id":"peVO6B64rNZCbXekUP_zH","children":[],"key":"M0STgUBZR1"}],"key":"dmxYBS1lNn"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"text","value":"All of us get confused about these sign conventions! It’s helpful to draw yourself a sketch of the fluxes going up and down.","position":{"start":{"line":151,"column":1},"end":{"line":151,"column":1}},"key":"xoC1jATyq3"}],"key":"IYMKu9z3Mb"},{"type":"paragraph","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"We should also verify that our results make sense physically. If I take the global, time average of the ","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"frczS9CLkx"},{"type":"inlineCode","value":"FLUS","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"sykKcnk5Wm"},{"type":"text","value":" field, it should be a large positive number!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"JqXmUiYGGM"}],"key":"rGox4PyZDC"},{"type":"paragraph","position":{"start":{"line":155,"column":1},"en