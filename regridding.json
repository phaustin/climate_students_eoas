0, 40, 60])\n\nresol = '50m'\n\nprovinc_bodr = cartopy.feature.NaturalEarthFeature(category='cultural', \n    name='admin_1_states_provinces_lines', scale=resol, facecolor='none', edgecolor='k')\nax2.add_feature(provinc_bodr, linestyle='--', linewidth=0.6, edgecolor=\"k\", zorder=10)\n\n\n\nhad_precip_data2010.plot(ax=ax2,cmap='coolwarm')\nax2.title.set_text(\"Precipitation total for 2010\")","key":"VfGjuYSGZk"},{"type":"outputs","id":"57HK-nbuOWOHh7Zz-28fp","children":[],"key":"PXzHdUyKcj"}],"key":"J2ru543xL1"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"GISS Re-grid","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"JcYf26tQMl"}],"identifier":"giss-re-grid","label":"GISS Re-grid","html_id":"giss-re-grid","implicit":true,"key":"RIaM0WeS5x"},{"type":"paragraph","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"Now regrid this data using the same steps as for the HadGEM.","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"ti1ryUcUfi"}],"key":"TbcFz5wgYh"}],"key":"JQjTWfJpXw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"regridder2 = xe.Regridder(gis_dset, ds_output, \"conservative\")\ngis_out = regridder2(gis_dset.pr, keep_attrs=True)","key":"NQLRhfFFOq"},{"type":"outputs","id":"IzAf3dnG4tnn3m8gx8S4c","children":[],"key":"eOH3onIkQx"}],"key":"BfuGribWOb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"gis_data1990 = gis_out.sel(time='2010')\ngis_precip_data1990 = gis_data1990.groupby('time.year').mean('time')*86400*365\ngis_precip_data1990 = gis_precip_data1990.mean('member_id')\n\nfig = plt.figure(1, figsize=[30,13])\n\nax = plt.subplot(1, 1, 1, projection=ccrs.PlateCarree())\nax.coastlines()\nax.add_feature(cartopy.feature.BORDERS, linestyle='-', alpha=1)\nax.set_extent([-140, -110, 40, 60])\n\nresol = '50m'\n\nprovinc_bodr = cartopy.feature.NaturalEarthFeature(category='cultural', \n    name='admin_1_states_provinces_lines', scale=resol, facecolor='none', edgecolor='k')\nax.add_feature(provinc_bodr, linestyle='--', linewidth=0.6, edgecolor=\"k\", zorder=10)\n\n\n\ngis_precip_data1990.plot(ax=ax,cmap='coolwarm')","key":"LCYAE8sX80"},{"type":"outputs","id":"tpD9Vpgwvq8--9lxvafoz","children":[],"key":"MxB5X5UkP4"}],"key":"coGiMeqh5y"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"Write the new files to file","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"EIJQYR4cxh"}],"identifier":"write-the-new-files-to-file","label":"Write the new files to file","html_id":"write-the-new-files-to-file","implicit":true,"key":"Hx4hc3Vlbh"},{"type":"paragraph","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"Write the re-gridded data to file in order to be used later in the plotting process.","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"boJPA9jaDE"}],"key":"RRpMyZlwHy"}],"key":"qAj8YpT5Tb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"write = False\nif write:\n    had_out.load().to_netcdf(data_folder / 'had_regrid.nc')\n    gis_out.load().to_netcdf(data_folder / 'gis_regrid.nc')\n    cru_out.load().to_netcdf(data_folder /'cru_regrid.nc')","key":"Z4ULeoTWN6"},{"type":"outputs","id":"EI6KJxsUUQcCXK88d8gjK","children":[],"key":"RuvNYl05N4"}],"key":"EpnTw5MuRN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"ylEfmkkLoP"},{"type":"outputs","id":"iVjujf13uXdsLvq_QJEit","children":[],"key":"MH12Uyc1G2"}],